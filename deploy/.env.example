# Production secrets: copy to .env, chmod 600 .env, fill locally; never commit.
# All three application images must share this release tag and repository.
# Canonical publisher: the manual GHCR release workflow.
IMAGE_REPOSITORY=
RELEASE_TAG=
DOMAIN=
# Actual ALB node-subnet CIDRs only, comma separated. ALB must use XFF append.
# Discover in your AWS account; do not commit private infrastructure values.
ALB_TRUSTED_CIDRS=
# Dedicated nginx-to-API network. The API trusts this nginx peer only.
PROXY_NETWORK_SUBNET=172.30.250.0/29
NGINX_API_PROXY_IP=172.30.250.2
API_PROXY_IP=172.30.250.3
# Absolute Linux path to the approved PRIVATE profile bundle, installed on EC2.
# Never copy this bundle into a Docker build context, image, registry or Git.
AUTHOR_PROFILE_HOST_DIR=

# Keep the existing database identity when upgrading. Use random hex secrets to
# avoid connection-string delimiters; generate separately: openssl rand -hex 32
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=blogdb
REDIS_PASSWORD=
JWT_SECRET=
JWT_ISSUER=BlogApp
JWT_AUDIENCE=BlogApp
JWT_EXPIRATION_MINUTES=60
ADMIN_EMAIL=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Three different random secrets (>=24 chars); never publish broker ports.
RABBITMQ_BACKEND_PASSWORD=
RABBITMQ_AGENT_PASSWORD=
RABBITMQ_DECLARER_PASSWORD=
# >=32 chars, shared ONLY by API and Python worker.
AGENT_CONTENT_SERVICE_KEY=

# External LLM: select the actual model you use; no mock/automatic fallback.
AGENT_LLM_API_KEY=
AGENT_LLM_BASE_URL=https://api.openai.com/v1
AGENT_LLM_MODEL=
# Optional for an OpenAI LLM key; REQUIRED when the LLM uses another provider.
# Embeddings always use OpenAI text-embedding-3-small, 1536 dimensions.
AGENT_EMBEDDING_API_KEY=
AGENT_EMBEDDING_BASE_URL=https://api.openai.com/v1
