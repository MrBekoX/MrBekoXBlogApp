# ===========================================
# BlogApp Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ===========================================
# Database Configuration
# ===========================================
POSTGRES_USER=blogapp
POSTGRES_PASSWORD=CHANGE_ME_use_openssl_rand_base64_32
POSTGRES_DB=blogdb

# Redis (REQUIRED)
REDIS_PASSWORD=CHANGE_ME_use_openssl_rand_base64_32

# ===========================================
# Application Settings
# ===========================================

# JWT Secret (minimum 32 characters — generate with: openssl rand -base64 48)
JwtSettings__Secret=CHANGE_ME_use_openssl_rand_base64_48

# Admin User (created on first startup)
AdminUser__Email=admin@example.com
AdminUser__UserName=admin
AdminUser__Password=CHANGE_ME_strong_password_min_12

# Internal service-to-service auth key
# ===========================================
# Hosting
# ===========================================

# Allowed hosts for Host header validation (comma-separated or *)
ALLOWED_HOSTS=yourdomain.com

# CORS origin (your frontend URL)
CORS_ORIGIN_0=http://localhost:3000

# Public SignalR URL (what browser connects to)
PUBLIC_SIGNALR_URL=http://localhost:8080

# Port bindings
BACKEND_PORT=8080
FRONTEND_PORT=3000
