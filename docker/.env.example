# Real local stack only. Copy to .env and configure all required values.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=blogdb_dev
REDIS_PASSWORD=
JwtSettings__Secret=
ADMIN_EMAIL=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ALLOWED_HOSTS=localhost;127.0.0.1
CORS_ORIGIN_0=http://localhost:3000
PUBLIC_SIGNALR_URL=http://localhost:8080
PUBLIC_AUTHOR_NAME=
# Only explicitly approved public links; empty values omit those links.
PUBLIC_GITHUB_URL=
PUBLIC_TWITTER_URL=
PUBLIC_LINKEDIN_URL=
PUBLIC_TWITTER_HANDLE=
# Same private bundle for API and worker; never copied into images or Git.
AUTHOR_PROFILE_HOST_DIR=../private/production-author-profile
BACKEND_PORT=8080
FRONTEND_PORT=3000
ASPNETCORE_ENVIRONMENT=Development
# Local broker bootstrap identity; production uses three isolated identities.
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=
AGENT_CONTENT_SERVICE_KEY=
AGENT_LLM_API_KEY=
AGENT_LLM_BASE_URL=https://api.openai.com/v1
AGENT_LLM_MODEL=
# Required separately when the LLM key belongs to another provider.
AGENT_EMBEDDING_API_KEY=
AGENT_EMBEDDING_BASE_URL=https://api.openai.com/v1
TURNSTILE_SITE_KEY=
