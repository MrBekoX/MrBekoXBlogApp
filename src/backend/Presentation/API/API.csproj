<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>BlogApp.Server.Api</UserSecretsId>
    <RootNamespace>BlogApp.Presentation.Api</RootNamespace>
    <AssemblyName>BlogApp.Presentation.Api</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Http" Version="8.1.0" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="8.1.0" />
    <PackageReference Include="AspNetCoreRateLimit" Version="5.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- W5 güvenlik duyuruları: Microsoft.OpenApi 2.3.0 GHSA-v5pm-xwqc-g5wc → 2.x yaması
         2.7.5; OpenTelemetry.Api 1.15.1 GHSA-g94r-2vxg-569j → yama 1.15.3 (doğrudan
         referans geçişli 1.15.1'i ezer). -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
    <PackageReference Include="AspNetCore.HealthChecks.Redis" Version="9.0.0" />
    <PackageReference Include="OpenTelemetry.Api" Version="1.15.3" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.15.1-beta.1" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.15.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.15.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" Version="1.15.0-beta.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.0" />
    <PackageReference Include="System.ServiceModel.Syndication" Version="10.0.5" />
    <!-- Override the EF design-time tooling dependency affected by CVE-2026-84008/70162. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.21" PrivateAssets="all" />
  </ItemGroup>

  <!-- Who am I (K2, A33): canonical yazar profili tek kaynaktan (src/content/author-profile)
       build ve publish çıktısına content/author-profile/ olarak kopyalanır; çalışma zamanı
       okuyucusu (FileAuthorProfileSource) AppContext.BaseDirectory/content/author-profile'ı
       okur (cwd veya geliştirici yolu kullanılmaz). Kopya bayt-birebirdir; content_hash
       (sha256(profile.json)) manifest ile doğrulanır. Docker build bağlamı bu yolu içerir
       (docker/backend/Dockerfile). Api.Tests ProjectReference ile aynı dosyaları alır. -->
  <PropertyGroup>
    <AuthorProfileSourceDir>$(MSBuildThisFileDirectory)..\..\..\content\author-profile\</AuthorProfileSourceDir>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="$(AuthorProfileSourceDir)manifest.json"
             Link="content\author-profile\manifest.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(AuthorProfileSourceDir)profile.json"
             Link="content\author-profile\profile.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(AuthorProfileSourceDir)source\**\*"
             Link="content\author-profile\source\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Application\Application.csproj" />
    <ProjectReference Include="..\..\Infrastructure\Infrastructure\Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.*.json"
             CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
