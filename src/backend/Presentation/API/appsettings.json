{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "AspNetCoreRateLimit": "Debug"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": ""
  },
  "JwtSettings": {
    "Secret": "",
    "Issuer": "BlogApp",
    "Audience": "BlogApp",
    "ExpirationMinutes": 20
  },
  "AdminUser": {
    "Email": "",
    "UserName": "",
    "Password": "",
    "FirstName": "Admin"
  },
  "AgentService": {
    "InternalApiKey": ""
  },
  "CorsOrigins": [],
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "IpWhitelist": [],
    "ClientWhitelist": [],
    "QuotaExceededResponse": {
      "Content": "{{ \"message\": \"API cagrisi kotasi asildi! Maksimum {0} istek / {1}. Lutfen bekleyin.\", \"retryAfter\": \"{2}\" }}",
      "ContentType": "application/json",
      "StatusCode": 429
    },
    "EndpointWhitelist": [
      "get:/hubs/*"
    ],
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 300
      },
      {
        "Endpoint": "*",
        "Period": "1h",
        "Limit": 3000
      },
      {
        "Endpoint": "post:/api/v1/auth/login",
        "Period": "1m",
        "Limit": 5
      },
      {
        "Endpoint": "post:/api/v1/auth/register",
        "Period": "1h",
        "Limit": 10
      },
      {
        "Endpoint": "post:/api/v1/media/upload/image",
        "Period": "1m",
        "Limit": 10
      },
      {
        "Endpoint": "post:/api/v1/media/upload/images",
        "Period": "5m",
        "Limit": 5
      },
      {
        "Endpoint": "post:/api/v1/auth/refresh-token",
        "Period": "1m",
        "Limit": 10
      },
      {
        "Endpoint": "post:/api/v1/auth/change-password",
        "Period": "1h",
        "Limit": 5
      }
    ]
  },
  "ServerLimits": {
    "MaxRequestBodySizeBytes": 50000000,
    "MultipartBodyLengthLimit": 50000000,
    "FormValueLengthLimit": 4194304,
    "MultipartHeadersLengthLimit": 65536,
    "SignalRKeepAliveIntervalSeconds": 10,
    "SignalRClientTimeoutSeconds": 30,
    "SignalRHandshakeTimeoutSeconds": 15,
    "ForwardedHeadersForwardLimit": 2,
    "CategoriesCacheMinutes": 10,
    "TagsCacheMinutes": 10,
    "SitemapCacheMinutes": 60,
    "RobotsCacheMinutes": 1440,
    "LlmsTxtCacheMinutes": 360,
    "RssFeedCacheMinutes": 30,
    "RssFeedMaxPosts": 20,
    "LlmsTxtMaxPosts": 50
  },
  "AllowedHosts": ""
}
