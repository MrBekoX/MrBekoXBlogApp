{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract": "blog.agent.messaging",
  "version": 1,
  "description": "B1 mesaj sözleşmesi kaydı: sürüm, boyut sınırı, üretici kimlikleri ve mesaj türü bazlı yön/exchange/routing eşlemeleri. Kaynak: docs/ai-agent-plan/02-rabbitmq-haberlesme-plani.md (Aşama B1, satır 181-241).",
  "content_type": "application/json",
  "max_payload_bytes": 262144,
  "producers": ["backend-net", "agent-py", "test-executor"],
  "exchanges": {
    "commands": "blog.agent.commands",
    "events": "blog.agent.events",
    "content": "blog.content.events"
  },
