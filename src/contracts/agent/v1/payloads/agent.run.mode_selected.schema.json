{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:blog-agent:v1:payload:agent.run.mode_selected",
  "title": "AgentRunModeSelectedPayloadV1",
  "description": "Router kararının bildirimi (A1 RouteDecision). requires_web_search yalnız deep_research modunda true olabilir.",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_sequence", "selected_mode", "requires_web_search", "reason"],
  "properties": {
    "event_sequence": { "type": "integer", "minimum": 0 },
    "execution_attempt": { "type": "integer", "minimum": 1 },
    "fencing_token": { "type": "string", "minLength": 1, "maxLength": 128 },
    "selected_mode": { "$ref": "urn:blog-agent:v1:common#/$defs/agent_mode" },
    "requires_web_search": { "type": "boolean" },
    "reason": { "type": "string", "minLength": 1, "maxLength": 2000 }
  },
  "allOf": [
    {
      "if": { "properties": { "requires_web_search": { "const": true } }, "required": ["requires_web_search"] },
      "then": { "properties": { "selected_mode": { "const": "deep_research" } } }
    }
  ]
}
