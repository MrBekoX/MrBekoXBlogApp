{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:blog-agent:v1:payload:content.sync.batch",
  "title": "ContentSnapshotBatchPayloadV1",
  "description": "Başlangıç içerik senkronizasyonu toplu referans paketi (Backend → Python). İçerik gövdesi gömülmez; yalnız (article_id, revision, hash) referansları taşınır (K7). batch_index < total_batches doğrulayıcı kuralıdır.",
  "type": "object",
  "additionalProperties": false,
  "required": ["sync_id", "batch_index", "total_batches", "items"],
  "properties": {
    "sync_id": { "$ref": "urn:blog-agent:v1:common#/$defs/identifier" },
    "batch_index": { "type": "integer", "minimum": 0 },
    "total_batches": { "type": "integer", "minimum": 1 },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["article_id", "article_revision", "content_hash"],
        "properties": {
          "article_id": { "$ref": "urn:blog-agent:v1:common#/$defs/identifier" },
          "article_revision": { "type": "integer", "minimum": 0 },
          "content_hash": { "$ref": "urn:blog-agent:v1:common#/$defs/hash_hex" }
        }
      }
    }
  }
}
