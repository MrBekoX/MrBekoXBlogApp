{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract": "blog.agent.messaging",
  "version": 2,
  "description": "v2 run mesaj sozlesmesi: v1'in run kapsamli 13 turu + konu (conversation_topic), etkin niyet (run_intent), profil snapshot referansi ve profile kaynak turu. content.* turleri v1'de kalir. Uretici: _generate_v2.py.",
  "content_type": "application/json",
  "max_payload_bytes": 262144,
  "producers": [
    "backend-net",
    "agent-py",
    "test-executor"
  ],
  "exchanges": {
    "commands": "blog.agent.commands",
    "events": "blog.agent.events",
    "content": "blog.content.events"
  },
  "message_types": {
    "agent.execute.requested": {
      "payload_schema": "payloads/agent.execute.requested.schema.json",
      "direction": "backend_to_agent",
      "exchange": "blog.agent.commands",
      "routing_key": "agent.execute.requested.v2",
      "allowed_producers": [
        "backend-net",
        "test-executor"
      ],
      "requires_run_identity": true,
      "requires_deadline": true
    },
    "agent.cancel.requested": {
      "payload_schema": "payloads/agent.cancel.requested.schema.json",
      "direction": "backend_to_agent",
      "exchange": "blog.agent.commands",
      "routing_key": "agent.cancel.requested.v2",
      "allowed_producers": [
        "backend-net",
        "test-executor"
      ],
      "requires_run_identity": true,
      "requires_deadline": false
    },
    "agent.resume.requested": {
      "payload_schema": "payloads/agent.resume.requested.schema.json",
      "direction": "backend_to_agent",
      "exchange": "blog.agent.commands",
      "routing_key": "agent.resume.requested.v2",
      "allowed_producers": [
        "backend-net",
        "test-executor"
      ],
      "requires_run_identity": true,
      "requires_deadline": false
    },
    "agent.action.result": {
      "payload_schema": "payloads/agent.action.result.schema.json",
      "direction": "backend_to_agent",
