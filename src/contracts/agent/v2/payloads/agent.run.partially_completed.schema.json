{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:blog-agent:v2:payload:agent.run.partially_completed",
  "title": "AgentRunPartiallyCompletedPayloadV2",
  "description": "Terminal kısmi başarı olayı (A1 AgentOutcome.status=partial): answer veya report zorunlu, ikisi aynı anda dolu olamaz; açık kalan sorular taşınabilir.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_sequence",
    "selected_mode",
    "source_scope",
    "usage",
    "run_intent"
  ],
  "properties": {
    "event_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "execution_attempt": {
      "type": "integer",
      "minimum": 1
    },
    "fencing_token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "selected_mode": {
      "$ref": "urn:blog-agent:v2:common#/$defs/agent_mode"
    },
    "answer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200000
    },
    "report": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200000
    },
    "citations": {
      "type": "array",
      "items": {
        "$ref": "urn:blog-agent:v2:common#/$defs/source_reference"
      }
    },
    "source_scope": {
      "$ref": "urn:blog-agent:v2:common#/$defs/source_scope"
    },
    "unresolved_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 20000
      }
    },
    "usage": {
      "$ref": "urn:blog-agent:v2:common#/$defs/usage_record"
    },
    "run_intent": {
      "$ref": "urn:blog-agent:v2:common#/$defs/run_intent"
    },
    "profile_snapshot": {
      "$ref": "urn:blog-agent:v2:common#/$defs/profile_snapshot_ref"
    }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "required": [
            "answer"
          ]
        },
        {
          "required": [
            "report"
          ]
        }
      ]
    },
    {
      "not": {
        "allOf": [
          {
            "required": [
              "answer"
            ]
          },
          {
            "required": [
              "report"
            ]
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "run_intent": {
            "const": "profile"
          }
        },
        "required": [
          "run_intent"
        ]
      },
      "then": {
        "required": [
          "profile_snapshot"
        ],
        "properties": {
          "source_scope": {
            "const": "profile"
          },
          "citations": {
            "type": "array",
            "items": {
              "properties": {
                "kind": {
                  "const": "profile"
                }
              }
            }
          }
        },
        "not": {
          "required": [
            "action_proposal"
          ]
        }
      }
    }
  ]
}
