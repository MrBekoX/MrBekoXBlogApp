{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:blog-agent:v2:payload:agent.run.progressed",
  "title": "AgentRunProgressedPayloadV2",
  "description": "DomainProgress olayının taşıma karşılığı (W0 Ç6): her ara ilerleme olayı monoton event_sequence ile yayınlanır; terminal sonuç bu değildir.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_sequence",
    "kind",
    "message"
  ],
  "properties": {
    "event_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "execution_attempt": {
      "type": "integer",
      "minimum": 1
    },
    "fencing_token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "kind": {
      "$ref": "urn:blog-agent:v2:common#/$defs/progress_kind"
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "detail": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
