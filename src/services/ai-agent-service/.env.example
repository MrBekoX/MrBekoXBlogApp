# Production uses deployment-managed environment values; never commit real keys.
# Copy this file to .env only for local development.
# Chat Completions capabilities must match the configured provider/model.
AGENT_LLM_OUTPUT_TOKEN_PARAMETER=max_tokens
AGENT_LLM_SUPPORTS_TEMPERATURE=true
AGENT_LLM_STREAM_USAGE=true
# Per immutable article revision/model; existing bounded input ceilings.
AGENT_CONTENT_SYNC_MAX_EMBEDDING_TOKENS=1048576
AGENT_CONTENT_SYNC_MAX_EMBEDDING_REQUESTS=2177
# Optional OTLP/HTTP endpoint including /v1/traces; empty disables export.
AGENT_OTEL_ENDPOINT=
AGENT_OTEL_TIMEOUT_SECONDS=1
# AGENT_ENV_FILE=/dev/null disables dotenv discovery in Linux containers.

AGENT_DB_HOST=127.0.0.1
AGENT_DB_PORT=5432
AGENT_DB_USER=blogapp_user
AGENT_DB_NAME=blogdb_dev
AGENT_DB_SCHEMA=agent
AGENT_DB_PASSWORD=
AGENT_DB_POOL_MIN=1
AGENT_DB_POOL_MAX=2

# The backend declares topology. Use the provisioned worker identity.
AGENT_BROKER_HOST=127.0.0.1
AGENT_BROKER_PORT=5672
AGENT_BROKER_USERNAME=agent_svc
AGENT_BROKER_PASSWORD=
AGENT_BROKER_VHOST=blogapp_dev
AGENT_BROKER_PREFETCH=1
AGENT_TOPOLOGY_DECLARE=false

# Both model and content access are mandatory; missing values fail startup.
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=
AGENT_LLM_BASE_URL=https://api.openai.com/v1
AGENT_EMBEDDING_API_KEY=
AGENT_EMBEDDING_BASE_URL=https://api.openai.com/v1
AGENT_EMBEDDING_MODEL=text-embedding-3-small
AGENT_EMBEDDING_DIMENSIONS=1536
AGENT_EMBEDDING_BATCH_SIZE=16
# Empty embedding key reuses the LLM key only for the default OpenAI endpoint.

AGENT_CONTENT_BASE_URL=http://127.0.0.1:8080/api/v1
AGENT_CONTENT_SERVICE_KEY=
AGENT_CANONICAL_URL_TEMPLATE=http://localhost:3000/posts/{slug}
# Source checkout discovers canonical profile content automatically.
# Containers set AGENT_PROFILE_DIR=/srv/content/author-profile.
# Missing or invalid canonical source fails worker startup.

AGENT_LOG_LEVEL=INFO
AGENT_WORKER_QUEUE_CLASSES=fast,research
AGENT_WORKER_POLL_INTERVAL=1.0
AGENT_WORKER_MAX_ATTEMPTS=3
