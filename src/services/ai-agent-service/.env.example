# =============================================================================
# AI agent servisi — .env örnek dosyası
# =============================================================================
# Kullanım:  cp .env.example .env   (hizmet kökünde: src/services/ai-agent-service)
#
# Öncelik sırası: GERÇEK ORTAM değişkeni > .env dosyası > kod varsayılanı.
# (.env yalnız os.environ'da OLMAYAN anahtarları doldurur.)
#
# Üretimde .env ZORUNLU DEĞİLDİR: değerleri deployment ortamından verebilirsiniz.
# Farklı bir yol için AGENT_ENV_FILE değişkeniyle dosya gösterebilirsiniz
# (yol verilmişse dosyanın var olması zorunludur). Alembic (migrations/env.py)
# de aynı .env dosyasını okur.
#
# GÜVENLİK: Bu dosyada GERÇEK SIR BULUNMAZ. Doldurduğunuz .env dosyası
# git'e girmez (.gitignore kapsamındadır); değerleri hiçbir yere yazmayın.
# =============================================================================

# ---- Zorunlu: doldurulmadan servis/migration çalışmaz -----------------------
AGENT_DB_PASSWORD=
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=

# ---- Veritabanı (agent schema; D011) ----------------------------------------
#AGENT_DB_HOST=127.0.0.1
#AGENT_DB_PORT=5432
#AGENT_DB_USER=blogapp_user
#AGENT_DB_NAME=blogdb_dev
#AGENT_DB_SCHEMA=agent
#AGENT_DB_POOL_MIN=1
#AGENT_DB_POOL_MAX=4
#AGENT_DB_COMMAND_TIMEOUT=10.0
# Alembic alternatifi: AGENT_DB_URL verilirse AGENT_DB_* yerine doğrudan kullanılır.
#AGENT_DB_URL=postgresql+asyncpg://KULLANICI:PAROLA@127.0.0.1:5432/blogdb_dev

# ---- RabbitMQ broker (aio-pika) ----------------------------------------------
#AGENT_BROKER_HOST=127.0.0.1
#AGENT_BROKER_PORT=5672
#AGENT_BROKER_USERNAME=agent_svc
#AGENT_BROKER_PASSWORD=agent_svc_dev
#AGENT_BROKER_VHOST=blogapp_dev
#AGENT_BROKER_CLIENT_NAME=agent-py
#AGENT_BROKER_HEARTBEAT=30
#AGENT_BROKER_RECONNECT_INTERVAL=5.0
#AGENT_BROKER_CONNECT_TIMEOUT=10.0
#AGENT_BROKER_PREFETCH=16

# ---- LLM sağlayıcı (OpenAI-uyumlu streaming) ---------------------------------
# Anahtar doluysa gerçek sağlayıcı kurulur; boşsa anahtarsız mevcut davranış sürer.
#AGENT_LLM_BASE_URL=https://api.openai.com/v1
#AGENT_LLM_CONNECT_TIMEOUT=10.0
#AGENT_LLM_REQUEST_TIMEOUT=120.0

# ---- İçerik deposu (backend iç ucu) ------------------------------------------
# BASE_URL boşsa içerik deposu bağlanmaz (MEVCUT davranış); doluysa SERVICE_KEY zorunludur.
#AGENT_CONTENT_BASE_URL=
#AGENT_CONTENT_SERVICE_KEY=
#AGENT_CONTENT_TIMEOUT_SECONDS=10.0

# ---- Çalışma zamanı ------------------------------------------------------------
#AGENT_LOG_LEVEL=INFO
# D013: topolojiyi agent declare etmez; yalnız yalıtık geliştirme/test vhost'larında 1 yapın.
#AGENT_TOPOLOGY_DECLARE=0
#AGENT_WORKER_ID=agent-py-worker
#AGENT_WORKER_QUEUE_CLASSES=fast,research
#AGENT_WORKER_LEASE_SECONDS=60.0
#AGENT_WORKER_POLL_INTERVAL=0.5
#AGENT_WORKER_MAX_ATTEMPTS=3
#AGENT_REAPER_INTERVAL=30.0
#AGENT_RELAY_INTERVAL=0.2
